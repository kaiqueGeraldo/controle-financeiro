# Local release preparation: build context contains ONLY the verified api.jar.
# Supply the resolved runtime digest and both provenance arguments explicitly.
ARG JAVA_RUNTIME=eclipse-temurin:21-jdk
FROM ${JAVA_RUNTIME}
WORKDIR /app
ARG INPUT_COMMIT
ARG JAR_SHA256
COPY api.jar /app/api.jar
RUN test -n "$INPUT_COMMIT" && test -n "$JAR_SHA256" && printf '%s  /app/api.jar\n' "$JAR_SHA256" | sha256sum -c -
LABEL org.opencontainers.image.revision=$INPUT_COMMIT \
      com.controlefinanceiro.jar.sha256=$JAR_SHA256
USER 10001:10001
ENV SPRING_PROFILES_ACTIVE=adoption
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/api.jar"]
